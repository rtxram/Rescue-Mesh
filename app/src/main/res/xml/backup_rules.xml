<full-backup-content>
    <!-- Never back up the device's private identity keys or the local database. -->
    <exclude domain="sharedpref" path="rescuemesh_identity.xml"/>
    <exclude domain="database" path="rescuemesh.db"/>
    <exclude domain="database" path="rescuemesh.db-wal"/>
    <exclude domain="database" path="rescuemesh.db-shm"/>
</full-backup-content>
